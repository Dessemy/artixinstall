#!/bin/bash

set -e

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
info()  { echo -e "${GREEN}[INFO]${NC} $1"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

[ "$(id -u)" -eq 0 ] || error "Run as root."

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIRS=(cava dwl foot rmpc mako nvim qutebrowser scripts yazi)
THEME_NAME="tokyonight"
THEME_FONT="FiraCode Nerd Font Propo Bold 15"

# clear any leftover immutable flag from a previous interrupted run of this
# script (a prior run may have chattr +i'd this file, which would make
# every DNS-dependent step below fail with "Operation not permitted")
chattr -i /etc/resolv.conf 2>/dev/null || true

# start haveged early to keep the kernel entropy pool full. Without this,
# GPG/pacman-key operations can hang for a long time on idle physical
# hardware waiting for enough randomness — this includes the live ISO's
# own "pacman-init" service (which can silently sit for 20+ minutes) and
# "pacman-key --populate archlinux" later inside the chroot. The entropy
# pool is kernel-wide, so starting haveged once here, before anything
# else touches pacman/GPG, fixes both.
if command -v haveged >/dev/null 2>&1; then
    if ! pgrep -x haveged >/dev/null 2>&1; then
        info "Starting haveged to keep the entropy pool full ..."
        haveged -w 1024 2>/dev/null || warn "Failed to start haveged, entropy-dependent steps below may be slow."
    fi
else
    warn "haveged not found — GPG/pacman-key steps may hang on idle physical hardware. Consider installing haveged first: pacman -Sy --noconfirm haveged"
fi

# pacman-init (the live ISO's own key-population service) has proven to
# reliably hang on this hardware — it tries to reach a GPG keyserver over
# the network and the request never comes back, even though ordinary
# HTTPS traffic works fine (different port, often blocked by routers/ISPs).
# Give it a short window to finish on its own, then kill it and populate
# the keyring manually from the local keyring files only (no network
# needed for this — every key artix/archlinux ship is already on disk).
if pgrep -x pacman-init >/dev/null 2>&1; then
    info "pacman-init is running — waiting up to 20s for it to finish naturally ..."
    for i in $(seq 1 20); do
        pgrep -x pacman-init >/dev/null 2>&1 || break
        sleep 1
    done
    if pgrep -x pacman-init >/dev/null 2>&1; then
        warn "pacman-init still stuck after 20s (known network/keyserver hang on this hardware) — killing it and populating the keyring manually instead."
        pkill -9 -x pacman-init 2>/dev/null || true
        pkill -9 -x gpg-agent 2>/dev/null || true
        rm -f /var/lib/pacman/db.lck 2>/dev/null || true
        pacman-key --init
        pacman-key --populate archlinux artix 2>/dev/null || pacman-key --populate archlinux
    fi
fi

# ensure parted is available
if ! command -v parted >/dev/null 2>&1; then
    info "parted not found, installing ..."
    pacman -Sy --noconfirm parted || error "Failed to install parted. Check your internet connection."
fi

# boot mode
if [ -d /sys/firmware/efi/efivars ]; then
    BOOT_MODE="uefi"
else
    BOOT_MODE="bios"
fi
info "Boot mode: $BOOT_MODE"

# input
echo
lsblk -d -o NAME,SIZE,MODEL
echo
read -rp "Target disk (e.g. /dev/sda or /dev/nvme0n1): " DISK
[ -b "$DISK" ] || error "Disk $DISK not found."

read -rp "Hostname [artix]: " HOSTNAME
HOSTNAME=${HOSTNAME:-artix}

read -rp "New username [user]: " USERNAME
USERNAME=${USERNAME:-user}

while true; do
    read -rsp "Root password: " ROOT_PASS; echo
    read -rsp "Confirm root password: " ROOT_PASS2; echo
    [ "$ROOT_PASS" = "$ROOT_PASS2" ] && [ -n "$ROOT_PASS" ] && break
    warn "Passwords do not match or empty, try again."
done

while true; do
    read -rsp "Password for ${USERNAME}: " USER_PASS; echo
    read -rsp "Confirm password for ${USERNAME}: " USER_PASS2; echo
    [ "$USER_PASS" = "$USER_PASS2" ] && [ -n "$USER_PASS" ] && break
    warn "Passwords do not match or empty, try again."
done

read -rp "Timezone [Asia/Jakarta]: " TIMEZONE
TIMEZONE=${TIMEZONE:-Asia/Jakarta}

read -rp "EFI partition size in MiB [512]: " EFI_SIZE
EFI_SIZE=${EFI_SIZE:-512}

echo
warn "ALL DATA on $DISK will be ERASED!"
read -rp "Type 'YES' to continue: " CONFIRM
[ "$CONFIRM" = "YES" ] || error "Aborted."

# everything from here on is fully unattended — no more prompts are asked.
# close stdin now so that if any command below ever accidentally tries to
# read from the terminal (this is what caused the script to hang forever
# on a stray "cat" reading stdin instead of a file/heredoc), it gets an
# immediate EOF instead of blocking indefinitely.
exec < /dev/null

# partitioning
info "Partitioning $DISK ..."
if [[ "$DISK" == *"nvme"* || "$DISK" == *"mmcblk"* ]]; then
    PART_PREFIX="${DISK}p"
else
    PART_PREFIX="${DISK}"
fi

# cleanup leftovers from a previous run
info "Cleaning up any leftovers from a previous attempt ..."
swapoff -a 2>/dev/null || true
umount -R /mnt 2>/dev/null || true
for part in "${PART_PREFIX}"*; do
    [ -b "$part" ] && umount -f "$part" 2>/dev/null || true
done

wipefs -af "$DISK"
partprobe "$DISK" 2>/dev/null || true
sleep 1

parted -s "$DISK" mklabel gpt

if [ "$BOOT_MODE" = "uefi" ]; then
    parted -s "$DISK" mkpart EFI fat32 1MiB "${EFI_SIZE}MiB"
    parted -s "$DISK" set 1 esp on
    parted -s "$DISK" mkpart ROOT ext4 "${EFI_SIZE}MiB" 100%
    EFI_PART="${PART_PREFIX}1"
    ROOT_PART="${PART_PREFIX}2"
else
    parted -s "$DISK" mkpart BIOSBOOT 1MiB 2MiB
    parted -s "$DISK" set 1 bios_grub on
    parted -s "$DISK" mkpart ROOT ext4 2MiB 100%
    ROOT_PART="${PART_PREFIX}2"
fi

# retry until kernel sees the new partition table
for i in 1 2 3 4 5; do
    partprobe "$DISK" 2>/dev/null && break
    sleep 2
done
udevadm settle 2>/dev/null || true
sleep 2

# format
info "Formatting root as ext4 ..."
mkfs.ext4 -F "$ROOT_PART"

if [ "$BOOT_MODE" = "uefi" ]; then
    info "Formatting EFI as FAT32 ..."
    mkfs.fat -F32 "$EFI_PART"
fi

# mount
info "Mounting ..."
mount "$ROOT_PART" /mnt
if [ "$BOOT_MODE" = "uefi" ]; then
    mkdir -p /mnt/boot/efi
    mount "$EFI_PART" /mnt/boot/efi
fi

# stage dotfiles for the chroot step
mkdir -p /mnt/root/dotfiles-src
for dir in "${CONFIG_DIRS[@]}"; do
    if [ -d "$SCRIPT_DIR/$dir" ]; then
        cp -r "$SCRIPT_DIR/$dir" /mnt/root/dotfiles-src/
        info "Staged dotfiles: $dir"
    else
        warn "Dotfiles folder '$dir' not found next to this script, skipping"
    fi
done

if [ -f "$SCRIPT_DIR/bash/.bashrc" ] && [ -f "$SCRIPT_DIR/bash/starship.toml" ]; then
    cp "$SCRIPT_DIR/bash/.bashrc" /mnt/root/dotfiles-src/dot-bashrc
    cp "$SCRIPT_DIR/bash/starship.toml" /mnt/root/dotfiles-src/starship.toml
    info "Staged dotfiles: bash (.bashrc, starship.toml)"
else
    warn "bash/.bashrc or bash/starship.toml not found next to this script, skipping"
fi

# dwl is source code to be built with "make clean install" inside the chroot,
# not a dotfiles folder, so it's staged separately (not into ~/.config)
if [ -d "$SCRIPT_DIR/dwl" ]; then
    cp -r "$SCRIPT_DIR/dwl" /mnt/root/dwl-src
    info "Staged dwl source"
else
    warn "dwl source folder not found next to this script, skipping (dwl will not be built)"
fi

# tokyonight is a GTK theme, not a ~/.config dotfile, so it's staged
# separately (goes to ~/.local/share/themes inside the chroot)
if [ -d "$SCRIPT_DIR/$THEME_NAME" ]; then
    cp -r "$SCRIPT_DIR/$THEME_NAME" /mnt/root/theme-src
    info "Staged theme: $THEME_NAME"
else
    warn "Theme folder '$THEME_NAME' not found next to this script, skipping (GTK theme will not be installed)"
fi

# speed up pacman
sed -i 's/^#ParallelDownloads.*/ParallelDownloads = 5/' /etc/pacman.conf 2>/dev/null || true
pacman -Syy --noconfirm || true

# base install (retry, mirrors can be flaky)
info "Running basestrap ..."
BASESTRAP_PKGS="base base-devel elogind-runit dbus-runit \
    linux linux-firmware linux-headers \
    grub efibootmgr ntfs-3g dosfstools e2fsprogs \
    iwd iwd-runit iproute2 inetutils openssh openssh-runit openresolv \
    pipewire pipewire-alsa pipewire-pulse pipewire-jack wireplumber alsa-utils \
    bluez bluez-utils bluez-runit \
    mpd \
    git wget curl rsync unzip zip tar reflector \
    neovim sudo bash-completion \
    tree less pciutils usbutils"
BASESTRAP_OK=0
for i in 1 2 3; do
    if basestrap /mnt $BASESTRAP_PKGS; then
        BASESTRAP_OK=1
        break
    fi
    warn "basestrap attempt $i failed, retrying with a fresh mirror sync ..."
    pacman -Syy --noconfirm || true
    sleep 3
done
[ "$BASESTRAP_OK" -eq 1 ] || error "basestrap failed after multiple attempts. Try a different mirror or check your connection."

# fstab
info "Generating fstab ..."
fstabgen -U /mnt >> /mnt/etc/fstab

# chroot config
info "Configuring system ..."
cat > /mnt/root/chroot-setup.sh <<EOF
#!/bin/bash
set -e

echo "root:${ROOT_PASS}" | chpasswd

ln -sf /usr/share/zoneinfo/${TIMEZONE} /etc/localtime
hwclock --systohc

sed -i 's/#en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
locale-gen
echo "LANG=en_US.UTF-8" > /etc/locale.conf

echo "${HOSTNAME}" > /etc/hostname
cat >> /etc/hosts <<HOSTS
127.0.0.1   localhost
::1         localhost
127.0.1.1   ${HOSTNAME}.localdomain ${HOSTNAME}
HOSTS

useradd -m -G wheel -s /bin/bash "${USERNAME}"
echo "${USERNAME}:${USER_PASS}" | chpasswd

# sudo config: wheel group needs a password by default, via a drop-in
# file (never edit /etc/sudoers directly — a syntax error there can lock
# out all privilege escalation, a drop-in is validated independently)
mkdir -p /etc/sudoers.d
cat > /etc/sudoers.d/10-wheel <<'SUDOERS'
%wheel ALL=(ALL:ALL) ALL
SUDOERS
chmod 0440 /etc/sudoers.d/10-wheel
visudo -cf /etc/sudoers.d/10-wheel || { echo "ERROR: /etc/sudoers.d/10-wheel failed validation"; exit 1; }

# sanity check: confirm the user is actually in wheel and the sudoers
# drop-in is valid. We can't test an unattended privileged sudo call yet
# (the default policy correctly still requires a password at this point),
# so we check the two things that would make every later sudo call fail:
# group membership and sudoers syntax.
if ! id -nG "${USERNAME}" | grep -qw wheel; then
    echo "===================================================="
    echo "ERROR: ${USERNAME} is not in the 'wheel' group — every"
    echo "package install below will fail because of this."
    echo "===================================================="
    exit 1
fi

# add Arch repos (extra + multilib)
pacman -S --noconfirm artix-archlinux-support
pacman-key --populate archlinux

# Arch's geo-DNS mirror as reliable primary
cat > /etc/pacman.d/mirrorlist-arch <<'MIRRORLIST'
Server = https://geo.mirror.pkgbuild.com/\$repo/os/\$arch
MIRRORLIST

reflector --country Indonesia,Singapore,Japan --age 12 --protocol https --completion-percent 100 --sort rate \
    >> /etc/pacman.d/mirrorlist-arch 2>/dev/null \
    || reflector --age 24 --protocol https --completion-percent 100 --latest 20 --sort rate \
    >> /etc/pacman.d/mirrorlist-arch 2>/dev/null \
    || true

if ! grep -q '^\[extra\]' /etc/pacman.conf; then
cat >> /etc/pacman.conf <<PACMANCONF

[extra]
Include = /etc/pacman.d/mirrorlist-arch

[multilib]
Include = /etc/pacman.d/mirrorlist-arch
PACMANCONF
fi

pacman -Syy --noconfirm || echo "WARNING: pacman sync had issues (extra/multilib mirror may be flaky), continuing anyway."

# install staged dotfiles
mkdir -p /home/${USERNAME}/.config
if [ -d /root/dotfiles-src ]; then
    for dir in /root/dotfiles-src/*/; do
        [ -d "\$dir" ] || continue
        dname=\$(basename "\$dir")
        cp -r "\$dir" "/home/${USERNAME}/.config/\$dname"
        echo "  copied \$dname -> ~/.config/\$dname"
    done
    chown -R ${USERNAME}:${USERNAME} /home/${USERNAME}/.config

    # make every file in ~/.config/scripts executable so startdwl/snip/etc.
    # work right after install without manual chmod
    if [ -d "/home/${USERNAME}/.config/scripts" ]; then
        chmod -R +x "/home/${USERNAME}/.config/scripts"
        echo "  chmod +x applied to ~/.config/scripts/*"
    fi
fi

if [ -f /root/dotfiles-src/dot-bashrc ]; then
    cp /root/dotfiles-src/dot-bashrc "/home/${USERNAME}/.bashrc"
    echo "  copied .bashrc -> ~/.bashrc"
fi
if [ -f /root/dotfiles-src/starship.toml ]; then
    cp /root/dotfiles-src/starship.toml "/home/${USERNAME}/.config/starship.toml"
    echo "  copied starship.toml -> ~/.config/starship.toml"
fi
rm -rf /root/dotfiles-src

# a login shell (e.g. a TTY login) only reads ~/.bash_profile, so make it
# pull in ~/.bashrc too
cat > /home/${USERNAME}/.bash_profile <<'BASHPROFILE'
[[ -f "\$HOME/.bashrc" ]] && source "\$HOME/.bashrc"
BASHPROFILE
chown ${USERNAME}:${USERNAME} /home/${USERNAME}/.bashrc /home/${USERNAME}/.bash_profile

# sanity check: confirm .bash_profile will actually pull in .bashrc for this
# user (this is what makes tty1 auto-start of dwl work on login) — catch it
# now instead of discovering a silent black-screen-at-login later
if ! grep -q '\$HOME/\.bashrc' "/home/${USERNAME}/.bash_profile" 2>/dev/null; then
    echo "===================================================="
    echo "ERROR: /home/${USERNAME}/.bash_profile does not correctly"
    echo "source ~/.bashrc — tty1 auto-start of dwl will NOT work."
    echo "===================================================="
    exit 1
fi
if ! grep -q 'exec dbus-run-session.*startdwl' "/home/${USERNAME}/.bashrc" 2>/dev/null; then
    echo "WARNING: ~/.bashrc has no tty1 auto-start block for dwl"
    echo "(expected a line like: exec dbus-run-session ~/.config/scripts/startdwl)."
    echo "dwl will need to be started manually with 'sdwl' after login."
fi

mkdir -p /etc/iwd
cat >> /etc/iwd/main.conf <<IWD
[General]
EnableNetworkConfiguration=true

[Network]
NameResolvingService=resolvconf
IWD

# no static nameservers here — resolv.conf is left for resolvconf to
# generate on its own (from iwd on connect, or from wg-quick when the
# ProtonVPN toggle is used). A raw `cat > /etc/resolv.conf` would leave
# a file with no valid resolvconf signature, which makes wg-quick's later
# \`resolvconf -a protonvpn\` call fail with "signature mismatch"
rm -f /etc/resolv.conf 2>/dev/null || true
resolvconf -u 2>/dev/null || true

mkdir -p /etc/runit/runsvdir/default
ln -sf /etc/runit/sv/dbus /etc/runit/runsvdir/default/ 2>/dev/null || true
ln -sf /etc/runit/sv/iwd /etc/runit/runsvdir/default/ 2>/dev/null || true
ln -sf /etc/runit/sv/bluetoothd /etc/runit/runsvdir/default/ 2>/dev/null || true

usermod -aG audio,video,lp,storage "${USERNAME}"

mkdir -p "/home/${USERNAME}/Music" \
    "/home/${USERNAME}/Music/playlists" \
    "/home/${USERNAME}/Music/database" \
    "/home/${USERNAME}/Downloads" \
    "/home/${USERNAME}/Pictures/Wallpapers"
chown -R ${USERNAME}:${USERNAME} \
    "/home/${USERNAME}/Music" \
    "/home/${USERNAME}/.local" \
    "/home/${USERNAME}/.cache" \
    "/home/${USERNAME}/Downloads" \
    "/home/${USERNAME}/Pictures"

if [ ! -f "/home/${USERNAME}/.config/mpd/mpd.conf" ]; then
    mkdir -p "/home/${USERNAME}/.config/mpd"
    cat > "/home/${USERNAME}/.config/mpd/mpd.conf" <<MPDCONF
music_directory     "~/Music"
playlist_directory  "~/Music/playlist"
db_file             "~/Music/database"

bind_to_address     "127.0.0.1"
auto_update         "yes"

input {
        plugin "curl"
}

audio_output {
    type "pipewire"
    name "Pipewire Sound Server"
}
MPDCONF
    chown ${USERNAME}:${USERNAME} "/home/${USERNAME}/.config/mpd/mpd.conf"
fi

if ! grep -q 'pgrep -x mpd' "/home/${USERNAME}/.bashrc" 2>/dev/null; then
    cat >> "/home/${USERNAME}/.bashrc" <<'MPDAUTOSTART'

# auto-start mpd (music daemon) if not already running
pgrep -x mpd >/dev/null || mpd >/dev/null 2>&1
MPDAUTOSTART
fi

# driver install
GPU_INFO=\$(lspci -nnk | grep -Ei "VGA compatible controller|3D controller|Display controller")
echo "Detected GPU(s):"
echo "\$GPU_INFO"

GPU_COUNT=\$(echo "\$GPU_INFO" | grep -Eic "VGA compatible controller|3D controller")
HAS_NVIDIA=0; HAS_INTEL=0; HAS_AMD=0
echo "\$GPU_INFO" | grep -qi nvidia   && HAS_NVIDIA=1
echo "\$GPU_INFO" | grep -qi intel    && HAS_INTEL=1
echo "\$GPU_INFO" | grep -Eqi "amd|ati|radeon" && HAS_AMD=1

if [ "\$GPU_COUNT" -ge 2 ]; then
    echo "Dual/hybrid GPU setup detected (\$GPU_COUNT GPUs)."
else
    echo "Single GPU detected."
fi

GPU_PKGS="mesa vulkan-icd-loader"
[ "\$HAS_NVIDIA" -eq 1 ] && GPU_PKGS="\$GPU_PKGS nvidia-dkms nvidia-utils nvidia-settings opencl-nvidia"
[ "\$HAS_INTEL" -eq 1 ]  && GPU_PKGS="\$GPU_PKGS vulkan-intel intel-media-driver libva-intel-driver"
[ "\$HAS_AMD" -eq 1 ]    && GPU_PKGS="\$GPU_PKGS xf86-video-amdgpu vulkan-radeon libva-mesa-driver"

for pkg in \$GPU_PKGS; do
    pacman -S --needed --noconfirm "\$pkg" || echo "WARNING: failed to install \$pkg, skipping."
done

# remember the result for the GPU-switcher step below, which runs after
# yay is built (envycontrol is AUR-only)
if [ "\$GPU_COUNT" -ge 2 ] && [ "\$HAS_NVIDIA" -eq 1 ]; then
    echo "hybrid-nvidia" > /root/.gpu-mode
elif [ "\$GPU_COUNT" -ge 2 ]; then
    echo "hybrid-other" > /root/.gpu-mode
else
    echo "single" > /root/.gpu-mode
fi

if [ -d /root/dwl-src ]; then
    echo "Installing dwl build dependencies ..."
    pacman -S --needed --noconfirm \
        wayland wayland-protocols pkgconf \
        libxkbcommon libinput pixman fcft tllist wlroots0.19 \
        || echo "WARNING: failed to install dwl build deps, build below may fail."

    echo "Building dwl (make clean install) ..."
    ( cd /root/dwl-src && \
      WPROTO_DIR="\$(pkg-config --variable=pkgdatadir wayland-protocols)" && \
      if [ ! -f "\$WPROTO_DIR/staging/cursor-shape/cursor-shape-v1.xml" ] && \
         [ -f "\$WPROTO_DIR/stable/cursor-shape/cursor-shape-v1.xml" ]; then
          echo "NOTE: cursor-shape-v1 protocol has moved from staging/ to stable/"
          echo "      in this wayland-protocols version, patching Makefile ..."
          sed -i 's#staging/cursor-shape#stable/cursor-shape#g' Makefile
      fi )
    if ! ( cd /root/dwl-src && make clean install ) 2>&1 | tee /root/dwl-build.log; then
        echo "===================================================="
        echo "ERROR: dwl build/install failed. Full log above and"
        echo "saved at /root/dwl-build.log (still readable after"
        echo "chroot exits, at /mnt/root/dwl-build.log from the live"
        echo "environment). Common cause: the wlroots version in the"
        echo "Artix repos doesn't match what dwl's source/patches"
        echo "expect — check dwl's config.mk / README for the wlroots"
        echo "version it was written against."
        echo "===================================================="
        exit 1
    fi

    if [ -d /root/dwl-src/slstatus ]; then
        echo "Building slstatus (make clean install) ..."
        ( cd /root/dwl-src/slstatus && make clean install ) \
            || echo "WARNING: slstatus build/install failed (non-critical, dwl itself already installed)."
    fi

    command -v dwl >/dev/null 2>&1 || { echo "ERROR: dwl command still not found on PATH after install."; exit 1; }
    echo "dwl installed successfully: \$(command -v dwl)"

    rm -rf /root/dwl-src
else
    echo "ERROR: /root/dwl-src not staged — dwl source folder wasn't found next to"
    echo "the install script. Without dwl there is no window manager, aborting."
    exit 1
fi

# build yay (temporarily allow passwordless wheel for unattended build steps)
cat > /etc/sudoers.d/20-wheel-nopass <<'SUDOERS'
%wheel ALL=(ALL:ALL) NOPASSWD: ALL
SUDOERS
chmod 0440 /etc/sudoers.d/20-wheel-nopass
visudo -cf /etc/sudoers.d/20-wheel-nopass || { echo "ERROR: nopass sudoers drop-in failed validation"; exit 1; }

su - "${USERNAME}" -c "cd ~ && git clone https://aur.archlinux.org/yay-bin.git && cd yay-bin && makepkg -si --noconfirm" \
    || echo "WARNING: yay install failed, you can retry manually later."
# yay uses sudo by default, no extra config needed

# GPU switcher: only needed for hybrid setups that include an Nvidia GPU
# (e.g. Intel/AMD + Nvidia laptops). Installed here because envycontrol
# is AUR-only and yay was just built above.
if [ -f /root/.gpu-mode ] && [ "\$(cat /root/.gpu-mode)" = "hybrid-nvidia" ]; then
    echo "Hybrid Nvidia GPU setup detected, installing envycontrol (GPU switcher) ..."
    su - "${USERNAME}" -c "yay -S --needed --noconfirm envycontrol" \
        || echo "WARNING: envycontrol install failed, install it manually later with: yay -S envycontrol"
    echo "NOTE: switch GPU mode with 'sudo envycontrol -s integrated|nvidia|hybrid' then reboot."
elif [ -f /root/.gpu-mode ] && [ "\$(cat /root/.gpu-mode)" = "hybrid-other" ]; then
    echo "Dual GPU detected but no Nvidia GPU found, skipping GPU switcher (not needed for AMD/Intel-only hybrid, DRI_PRIME env var handles offloading)."
fi
rm -f /root/.gpu-mode

# dwl setup
cat > /home/${USERNAME}/dwl-install.sh <<'DWLSCRIPT'
#!/bin/bash
DWL_PKGS="foot wmenu mako cliphist swaybg wl-clipboard seatd seatd-runit
xorg-xwayland
ttf-firacode-nerd noto-fonts noto-fonts-cjk noto-fonts-emoji yazi
starship zoxide jq fd fzf fastfetch eza bat ripgrep imagemagick ffmpeg 7zip
ueberzugpp chafa ffmpegthumbnailer poppler mediainfo bluetui impala wiremix cava ttyper mpv rmpc mpc
brightnessctl playerctl libnotify gotop tlp tlp-rdw
nwg-look dconf gsettings-desktop-schemas hyprpicker
wireguard-tools grim slurp nodejs npm waylock github-cli
usbmount xdg-desktop-portal-no-systemd-rtkit xdg-desktop-portal-wlr qt5-wayland qt6-wayland
obs-studio qutebrowser"

for pkg in \$DWL_PKGS; do
    yay -S --needed --noconfirm "\$pkg" \
        || echo "WARNING: failed to install \$pkg, skipping."
done
DWLSCRIPT
chown ${USERNAME}:${USERNAME} /home/${USERNAME}/dwl-install.sh
chmod +x /home/${USERNAME}/dwl-install.sh

su - "${USERNAME}" -c /home/${USERNAME}/dwl-install.sh
rm -f /home/${USERNAME}/dwl-install.sh

# passwordless wg-quick for the ProtonVPN toggle keybinding (Super+Shift+V):
# spawn has no terminal to show a password prompt, so without this the
# script would silently fail every time.
WG_QUICK_BIN="\$(command -v wg-quick || echo /usr/bin/wg-quick)"
cat > /etc/sudoers.d/30-protonvpn <<SUDOERS
%wheel ALL=(root) NOPASSWD: \${WG_QUICK_BIN} up protonvpn, \${WG_QUICK_BIN} down protonvpn
SUDOERS
chmod 0440 /etc/sudoers.d/30-protonvpn
visudo -cf /etc/sudoers.d/30-protonvpn \
    || echo "WARNING: /etc/sudoers.d/30-protonvpn failed validation, ProtonVPN toggle will prompt for a password."

# install & apply the tokyonight GTK theme
if [ -d /root/theme-src ]; then
    echo "Installing GTK theme: ${THEME_NAME} ..."
    mkdir -p "/home/${USERNAME}/.local/share/themes"
    cp -r /root/theme-src "/home/${USERNAME}/.local/share/themes/${THEME_NAME}"
    chown -R ${USERNAME}:${USERNAME} "/home/${USERNAME}/.local/share/themes"
    rm -rf /root/theme-src

    su - "${USERNAME}" -c "dbus-run-session -- bash -c '
        gsettings set org.gnome.desktop.interface gtk-theme \"${THEME_NAME}\" &&
        gsettings set org.gnome.desktop.interface color-scheme \"prefer-dark\" &&
        gsettings set org.gnome.desktop.interface font-name \"${THEME_FONT}\"
    '" || echo "WARNING: gsettings apply failed, set the theme manually in nwg-look later."

    # export to gtk-3.0/gtk-4.0 settings.ini too, for apps that don't read gsettings directly
    su - "${USERNAME}" -c "dbus-run-session -- nwg-look -x" \
        || echo "WARNING: nwg-look -x export failed, run it manually later."

    echo "GTK theme '${THEME_NAME}' applied (font: ${THEME_FONT}, prefer-dark: on)."
else
    echo "WARNING: /root/theme-src not staged, tokyonight theme was not installed."
fi

su - "${USERNAME}" -c 'src=\$(mktemp -d) \
    && git clone --recursive --depth 1 https://github.com/akinomyoga/ble.sh.git "\$src" \
    && make -C "\$src" install PREFIX="\$HOME/.local" \
    && rm -rf "\$src"' \
    || echo "WARNING: ble.sh install failed, it will be retried automatically on first login."

# usbmount: auto-mount USB drives on plug-in (udev-triggered, no daemon/session needed)
if [ -f /etc/usbmount/usbmount.conf ]; then
    sed -i '/^FS_MOUNTOPTIONS=/d' /etc/usbmount/usbmount.conf
    echo 'FS_MOUNTOPTIONS="-fstype=vfat,gid=storage,dmask=0022,fmask=0133 -fstype=exfat,gid=storage,dmask=0022,fmask=0133 -fstype=ntfs,gid=storage,dmask=0022,fmask=0133"' \
        >> /etc/usbmount/usbmount.conf
else
    echo "WARNING: /etc/usbmount/usbmount.conf not found, usbmount may not be installed correctly."
fi

rm -f /etc/sudoers.d/20-wheel-nopass

# seatd for dwl
ln -sf /etc/runit/sv/seatd /etc/runit/runsvdir/default/ 2>/dev/null || true
usermod -aG seat "${USERNAME}"

# grub: no boot delay, no menu flash
sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=0/' /etc/default/grub
if grep -q '^GRUB_TIMEOUT_STYLE=' /etc/default/grub; then
    sed -i 's/^GRUB_TIMEOUT_STYLE=.*/GRUB_TIMEOUT_STYLE=hidden/' /etc/default/grub
else
    echo 'GRUB_TIMEOUT_STYLE=hidden' >> /etc/default/grub
fi

if [ -d /sys/firmware/efi/efivars ]; then
    grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=Artix
else
    grub-install --target=i386-pc ${DISK}
fi
grub-mkconfig -o /boot/grub/grub.cfg
EOF

chmod +x /mnt/root/chroot-setup.sh

# artix-chroot does NOT automatically give the target a working DNS
# config. Without this, every network call inside chroot-setup.sh
# (pacman -S, reflector, pacman-key key fetches) fails with "Could not
# resolve host" even though the live environment's own network is fine.
#
# The base package sometimes ships /etc/resolv.conf as a symlink (e.g.
# pointing at a stub-resolver path that doesn't exist yet in a freshly
# basestrapped target) — a plain `cp` onto that can fail silently or
# write through to nowhere. Remove whatever is there first, then copy,
# then print the result so a failure is visible immediately instead of
# surfacing 90 lines later as a mysterious DNS error.
info "Copying live environment's DNS config into the target ..."
mkdir -p /mnt/etc

# self-heal: iwd/dhcpcd can bring up a working connection (which is why
# basestrap above succeeded) without ever writing /etc/resolv.conf. If
# that's the case here, don't just fail — write known-good public
# resolvers so the rest of the install can proceed.
if [ ! -s /etc/resolv.conf ]; then
    warn "Live environment's own /etc/resolv.conf is empty — writing fallback DNS (1.1.1.1 / 8.8.8.8)."
    printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n' > /etc/resolv.conf
fi

rm -f /mnt/etc/resolv.conf 2>/dev/null || true
cp -L /etc/resolv.conf /mnt/etc/resolv.conf || error "Failed to copy resolv.conf into the target."
info "Target /mnt/etc/resolv.conf now contains:"
cat /mnt/etc/resolv.conf
[ -s /mnt/etc/resolv.conf ] || error "resolv.conf is still empty after fallback — network may not actually be connected. Check with: ping -c2 1.1.1.1"

artix-chroot /mnt /root/chroot-setup.sh
rm /mnt/root/chroot-setup.sh

info "Installation complete!"
echo
echo "For Wi-Fi after reboot, use: iwctl"
echo
info "Unmounting and rebooting in 5 seconds ... (Ctrl+C to cancel)"
sleep 5
umount -R /mnt
reboot
