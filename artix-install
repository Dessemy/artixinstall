#!/bin/bash

set -e

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
info()  { echo -e "${GREEN}[INFO]${NC} $1"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

[ "$(id -u)" -eq 0 ] || error "Run as root."

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIRS=(foot mako qutebrowser scripts nnn nvim)
THEME_NAME="tokyonight"
THEME_FONT="FiraCode Nerd Font Propo Bold 15"

# ensure parted is available
if ! command -v parted >/dev/null 2>&1; then
    info "parted not found, installing ..."
    pacman -Sy --noconfirm parted || error "Failed to install parted. Check your internet connection."
fi

# boot mode
if [ -d /sys/firmware/efi/efivars ]; then
    BOOT_MODE="uefi"
else
    BOOT_MODE="bios"
fi
info "Boot mode: $BOOT_MODE"

# input
echo
lsblk -d -o NAME,SIZE,MODEL
echo
read -rp "Target disk (e.g. /dev/sda or /dev/nvme0n1): " DISK
[ -b "$DISK" ] || error "Disk $DISK not found."

read -rp "Hostname [artix]: " HOSTNAME
HOSTNAME=${HOSTNAME:-artix}

read -rp "New username [user]: " USERNAME
USERNAME=${USERNAME:-user}

while true; do
    read -rsp "Root password: " ROOT_PASS; echo
    read -rsp "Confirm root password: " ROOT_PASS2; echo
    [ "$ROOT_PASS" = "$ROOT_PASS2" ] && [ -n "$ROOT_PASS" ] && break
    warn "Passwords do not match or empty, try again."
done

while true; do
    read -rsp "Password for ${USERNAME}: " USER_PASS; echo
    read -rsp "Confirm password for ${USERNAME}: " USER_PASS2; echo
    [ "$USER_PASS" = "$USER_PASS2" ] && [ -n "$USER_PASS" ] && break
    warn "Passwords do not match or empty, try again."
done

read -rp "Timezone [Asia/Jakarta]: " TIMEZONE
TIMEZONE=${TIMEZONE:-Asia/Jakarta}

read -rp "EFI partition size in MiB [512]: " EFI_SIZE
EFI_SIZE=${EFI_SIZE:-512}

echo
warn "ALL DATA on $DISK will be ERASED!"
read -rp "Type 'YES' to continue: " CONFIRM
[ "$CONFIRM" = "YES" ] || error "Aborted."

# partitioning
info "Partitioning $DISK ..."
if [[ "$DISK" == *"nvme"* || "$DISK" == *"mmcblk"* ]]; then
    PART_PREFIX="${DISK}p"
else
    PART_PREFIX="${DISK}"
fi

# cleanup leftovers from a previous run
info "Cleaning up any leftovers from a previous attempt ..."
swapoff -a 2>/dev/null || true
umount -R /mnt 2>/dev/null || true
for part in "${PART_PREFIX}"*; do
    [ -b "$part" ] && umount -f "$part" 2>/dev/null || true
done

wipefs -af "$DISK"
partprobe "$DISK" 2>/dev/null || true
sleep 1

parted -s "$DISK" mklabel gpt

if [ "$BOOT_MODE" = "uefi" ]; then
    parted -s "$DISK" mkpart EFI fat32 1MiB "${EFI_SIZE}MiB"
    parted -s "$DISK" set 1 esp on
    parted -s "$DISK" mkpart ROOT ext4 "${EFI_SIZE}MiB" 100%
    EFI_PART="${PART_PREFIX}1"
    ROOT_PART="${PART_PREFIX}2"
else
    parted -s "$DISK" mkpart BIOSBOOT 1MiB 2MiB
    parted -s "$DISK" set 1 bios_grub on
    parted -s "$DISK" mkpart ROOT ext4 2MiB 100%
    ROOT_PART="${PART_PREFIX}2"
fi

# retry until kernel sees the new partition table
for i in 1 2 3 4 5; do
    partprobe "$DISK" 2>/dev/null && break
    sleep 2
done
udevadm settle 2>/dev/null || true
sleep 2

# format
info "Formatting root as ext4 ..."
mkfs.ext4 -F "$ROOT_PART"

if [ "$BOOT_MODE" = "uefi" ]; then
    info "Formatting EFI as FAT32 ..."
    mkfs.fat -F32 "$EFI_PART"
fi

# mount
info "Mounting ..."
mount "$ROOT_PART" /mnt
if [ "$BOOT_MODE" = "uefi" ]; then
    mkdir -p /mnt/boot/efi
    mount "$EFI_PART" /mnt/boot/efi
fi

# stage dotfiles for the chroot step
mkdir -p /mnt/root/dotfiles-src
for dir in "${CONFIG_DIRS[@]}"; do
    if [ -d "$SCRIPT_DIR/$dir" ]; then
        cp -r "$SCRIPT_DIR/$dir" /mnt/root/dotfiles-src/
        info "Staged dotfiles: $dir"
    else
        warn "Dotfiles folder '$dir' not found next to this script, skipping"
    fi
done

if [ -f "$SCRIPT_DIR/bash/.bashrc" ] && [ -f "$SCRIPT_DIR/bash/starship.toml" ]; then
    cp "$SCRIPT_DIR/bash/.bashrc" /mnt/root/dotfiles-src/dot-bashrc
    cp "$SCRIPT_DIR/bash/starship.toml" /mnt/root/dotfiles-src/starship.toml
    info "Staged dotfiles: bash (.bashrc, starship.toml)"
else
    warn "bash/.bashrc or bash/starship.toml not found next to this script, skipping"
fi

# dwl is source code to be built with "make clean install" inside the chroot,
# not a dotfiles folder, so it's staged separately (not into ~/.config)
if [ -d "$SCRIPT_DIR/dwl" ]; then
    cp -r "$SCRIPT_DIR/dwl" /mnt/root/dwl-src
    info "Staged dwl source"
else
    warn "dwl source folder not found next to this script, skipping (dwl will not be built)"
fi

# tokyonight is a GTK theme, not a ~/.config dotfile, so it's staged
# separately (goes to ~/.local/share/themes inside the chroot)
if [ -d "$SCRIPT_DIR/$THEME_NAME" ]; then
    cp -r "$SCRIPT_DIR/$THEME_NAME" /mnt/root/theme-src
    info "Staged theme: $THEME_NAME"
else
    warn "Theme folder '$THEME_NAME' not found next to this script, skipping (GTK theme will not be installed)"
fi

# speed up pacman
sed -i 's/^#ParallelDownloads.*/ParallelDownloads = 5/' /etc/pacman.conf 2>/dev/null || true
pacman -Syy --noconfirm || true

# base install (retry, mirrors can be flaky)
info "Running basestrap ..."
BASESTRAP_PKGS="base base-devel elogind-runit dbus-runit \
    linux linux-firmware linux-headers \
    grub efibootmgr ntfs-3g dosfstools e2fsprogs \
    iwd iwd-runit iproute2 inetutils openssh openssh-runit openresolv \
    pipewire pipewire-alsa pipewire-pulse pipewire-jack wireplumber alsa-utils \
    bluez bluez-utils bluez-runit \
    mpd \
    git wget curl rsync unzip zip tar reflector \
    neovim opendoas bash-completion \
    tree less pciutils usbutils"
BASESTRAP_OK=0
for i in 1 2 3; do
    if basestrap /mnt $BASESTRAP_PKGS; then
        BASESTRAP_OK=1
        break
    fi
    warn "basestrap attempt $i failed, retrying with a fresh mirror sync ..."
    pacman -Syy --noconfirm || true
    sleep 3
done
[ "$BASESTRAP_OK" -eq 1 ] || error "basestrap failed after multiple attempts. Try a different mirror or check your connection."

# fstab
info "Generating fstab ..."
fstabgen -U /mnt >> /mnt/etc/fstab

# chroot config
info "Configuring system ..."
cat > /mnt/root/chroot-setup.sh <<EOF
#!/bin/bash
set -e

echo "root:${ROOT_PASS}" | chpasswd

ln -sf /usr/share/zoneinfo/${TIMEZONE} /etc/localtime
hwclock --systohc

sed -i 's/#en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
locale-gen
echo "LANG=en_US.UTF-8" > /etc/locale.conf

echo "${HOSTNAME}" > /etc/hostname
cat >> /etc/hosts <<HOSTS
127.0.0.1   localhost
::1         localhost
127.0.1.1   ${HOSTNAME}.localdomain ${HOSTNAME}
HOSTS

useradd -m -G wheel -s /bin/bash "${USERNAME}"
echo "${USERNAME}:${USER_PASS}" | chpasswd

# doas config (replaces sudo)
cat > /etc/doas.conf <<'DOASCONF'
permit persist :wheel
DOASCONF
chmod 0400 /etc/doas.conf

# thin sudo->doas shim so makepkg/yay (which call "sudo" internally) keep working
mkdir -p /usr/local/bin
cat > /usr/local/bin/sudo <<'SUDOSHIM'
#!/bin/sh
exec doas "$@"
SUDOSHIM
chmod +x /usr/local/bin/sudo

# tell makepkg to use doas natively too
sed -i "s/^#PACMAN_AUTH=.*/PACMAN_AUTH=(doas)/" /etc/makepkg.conf 2>/dev/null || \
    echo 'PACMAN_AUTH=(doas)' >> /etc/makepkg.conf

# add Arch repos (extra + multilib)
pacman -S --noconfirm artix-archlinux-support
pacman-key --populate archlinux

# Arch's geo-DNS mirror as reliable primary
cat > /etc/pacman.d/mirrorlist-arch <<'MIRRORLIST'
Server = https://geo.mirror.pkgbuild.com/\$repo/os/\$arch
MIRRORLIST

reflector --country Indonesia,Singapore,Japan --age 12 --protocol https --completion-percent 100 --sort rate \
    >> /etc/pacman.d/mirrorlist-arch 2>/dev/null \
    || reflector --age 24 --protocol https --completion-percent 100 --latest 20 --sort rate \
    >> /etc/pacman.d/mirrorlist-arch 2>/dev/null \
    || true

if ! grep -q '^\[extra\]' /etc/pacman.conf; then
cat >> /etc/pacman.conf <<PACMANCONF

[extra]
Include = /etc/pacman.d/mirrorlist-arch

[multilib]
Include = /etc/pacman.d/mirrorlist-arch
PACMANCONF
fi

pacman -Syy --noconfirm || echo "WARNING: pacman sync had issues (extra/multilib mirror may be flaky), continuing anyway."

# install staged dotfiles
mkdir -p /home/${USERNAME}/.config
if [ -d /root/dotfiles-src ]; then
    for dir in /root/dotfiles-src/*/; do
        [ -d "\$dir" ] || continue
        dname=\$(basename "\$dir")
        cp -r "\$dir" "/home/${USERNAME}/.config/\$dname"
        echo "  copied \$dname -> ~/.config/\$dname"
    done
    chown -R ${USERNAME}:${USERNAME} /home/${USERNAME}/.config
fi

if [ -f /root/dotfiles-src/dot-bashrc ]; then
    cp /root/dotfiles-src/dot-bashrc "/home/${USERNAME}/.bashrc"
    echo "  copied .bashrc -> ~/.bashrc"
fi
if [ -f /root/dotfiles-src/starship.toml ]; then
    cp /root/dotfiles-src/starship.toml "/home/${USERNAME}/.config/starship.toml"
    echo "  copied starship.toml -> ~/.config/starship.toml"
fi
rm -rf /root/dotfiles-src

# a login shell (e.g. a TTY login) only reads ~/.bash_profile, so make it
# pull in ~/.bashrc too
cat > /home/${USERNAME}/.bash_profile <<'BASHPROFILE'
[[ -f "$HOME/.bashrc" ]] && source "$HOME/.bashrc"
BASHPROFILE
chown ${USERNAME}:${USERNAME} /home/${USERNAME}/.bashrc /home/${USERNAME}/.bash_profile

mkdir -p /etc/iwd
cat >> /etc/iwd/main.conf <<IWD
[General]
EnableNetworkConfiguration=true

[Network]
NameResolvingService=resolvconf
IWD

# fallback DNS for first boot
rm -f /etc/resolv.conf 2>/dev/null || true
cat > /etc/resolv.conf <<RESOLV
nameserver 1.1.1.1
RESOLV

mkdir -p /etc/runit/runsvdir/default
ln -sf /etc/runit/sv/dbus /etc/runit/runsvdir/default/ 2>/dev/null || true
ln -sf /etc/runit/sv/iwd /etc/runit/runsvdir/default/ 2>/dev/null || true
ln -sf /etc/runit/sv/bluetoothd /etc/runit/runsvdir/default/ 2>/dev/null || true

usermod -aG audio,video,lp,storage "${USERNAME}"

# rmpc/mpd setup: music library + XDG data/cache dirs used by a typical
# per-user mpd.conf (matches whatever the staged mpd dotfiles expect)
mkdir -p "/home/${USERNAME}/Music" \
    "/home/${USERNAME}/.local/share/mpd/playlists" \
    "/home/${USERNAME}/.cache/mpd"
chown -R ${USERNAME}:${USERNAME} \
    "/home/${USERNAME}/Music" \
    "/home/${USERNAME}/.local/share/mpd" \
    "/home/${USERNAME}/.cache/mpd"

# if no mpd.conf came from the staged dotfiles, generate a working default
# so mpd actually starts instead of silently failing on first run
if [ ! -f "/home/${USERNAME}/.config/mpd/mpd.conf" ]; then
    mkdir -p "/home/${USERNAME}/.config/mpd"
    cat > "/home/${USERNAME}/.config/mpd/mpd.conf" <<MPDCONF
music_directory     "~/Music"
playlist_directory  "~/.local/share/mpd/playlists"
db_file             "~/.local/share/mpd/tag_cache"
log_file            "~/.cache/mpd/mpd.log"
pid_file            "~/.cache/mpd/mpd.pid"
state_file          "~/.local/share/mpd/state"
sticker_file        "~/.local/share/mpd/sticker.sql"

bind_to_address     "127.0.0.1"
port                "6600"
auto_update         "yes"

audio_output {
    type "pulse"
    name "PulseAudio (via pipewire-pulse)"
}
MPDCONF
    chown ${USERNAME}:${USERNAME} "/home/${USERNAME}/.config/mpd/mpd.conf"
fi

# if no rmpc config came from the staged dotfiles, leave it be — rmpc falls
# back to sane built-in defaults (127.0.0.1:6600) when config.ron is absent

# auto-start mpd on login (per-user daemon, not a system runit service, so
# it has access to the user's own pipewire/pulse session)
if ! grep -q 'pgrep -x mpd' "/home/${USERNAME}/.bashrc" 2>/dev/null; then
    cat >> "/home/${USERNAME}/.bashrc" <<'MPDAUTOSTART'

# auto-start mpd (music daemon) if not already running
pgrep -x mpd >/dev/null || mpd >/dev/null 2>&1
MPDAUTOSTART
fi

# driver install
GPU_INFO=\$(lspci -nnk | grep -Ei "VGA compatible controller|3D controller|Display controller")
echo "Detected GPU(s):"
echo "\$GPU_INFO"

GPU_PKGS="mesa vulkan-icd-loader"
echo "\$GPU_INFO" | grep -qi nvidia   && GPU_PKGS="\$GPU_PKGS nvidia-dkms nvidia-utils nvidia-settings opencl-nvidia"
echo "\$GPU_INFO" | grep -qi intel    && GPU_PKGS="\$GPU_PKGS vulkan-intel intel-media-driver libva-intel-driver"
echo "\$GPU_INFO" | grep -Eqi "amd|ati|radeon" && GPU_PKGS="\$GPU_PKGS xf86-video-amdgpu vulkan-radeon libva-mesa-driver"

for pkg in \$GPU_PKGS; do
    pacman -S --needed --noconfirm "\$pkg" || echo "WARNING: failed to install \$pkg, skipping."
done

# build & install dwl from local source (compositor + slstatus, with your
# local patches already applied to config.def.h). Runs as root inside the
# chroot, no AUR/makepkg needed for this part.
if [ -d /root/dwl-src ]; then
    echo "Installing dwl build dependencies ..."
    pacman -S --needed --noconfirm \
        wayland wayland-protocols pkgconf \
        libxkbcommon libinput pixman fcft wlroots \
        || echo "WARNING: failed to install dwl build deps, build below may fail."

    echo "Building dwl (make clean install) ..."
    ( cd /root/dwl-src && make clean install ) \
        || echo "WARNING: dwl build/install failed, check dependencies/patches."

    if [ -d /root/dwl-src/slstatus ]; then
        echo "Building slstatus (make clean install) ..."
        ( cd /root/dwl-src/slstatus && make clean install ) \
            || echo "WARNING: slstatus build/install failed."
    fi

    rm -rf /root/dwl-src
else
    echo "WARNING: /root/dwl-src not staged, dwl was not built from source."
fi

# build yay (temporarily allow passwordless wheel for unattended build steps)
cat > /etc/doas.conf <<'DOASCONF'
permit nopass :wheel
DOASCONF
chmod 0400 /etc/doas.conf

su - "${USERNAME}" -c "cd ~ && git clone https://aur.archlinux.org/yay-bin.git && cd yay-bin && makepkg -si --noconfirm" \
    || echo "WARNING: yay install failed, you can retry manually later."

# dwl setup
cat > /home/${USERNAME}/dwl-install.sh <<'DWLSCRIPT'
#!/bin/bash
DWL_PKGS="foot wmenu mako cliphist swaybg swaylock wl-clipboard seatd seatd-runit
xorg-xwayland
ttf-firacode-nerd noto-fonts noto-fonts-cjk noto-fonts-emoji
starship zoxide jq fd fzf fastfetch eza bat ripgrep imagemagick ffmpeg 7zip
nnn ueberzugpp chafa ffmpegthumbnailer poppler mediainfo bluetui impala wiremix cava ttyper mpv rmpc mpc
brightnessctl playerctl libnotify gotop tlp tlp-rdw
nwg-look dconf gsettings-desktop-schemas
wireguard-tools grim slurp nodejs npm waylock github-cli
usbmount xdg-desktop-portal-no-systemd-rtkit xdg-desktop-portal-wlr qt5-wayland qt6-wayland
steam obs-studio lutris qutebrowser vesktop-bin onlyoffice-bin blender-bin"

for pkg in \$DWL_PKGS; do
    yay -S --needed --noconfirm "\$pkg" || echo "WARNING: failed to install \$pkg, skipping."
done
DWLSCRIPT
chown ${USERNAME}:${USERNAME} /home/${USERNAME}/dwl-install.sh
chmod +x /home/${USERNAME}/dwl-install.sh

su - "${USERNAME}" -c /home/${USERNAME}/dwl-install.sh
rm -f /home/${USERNAME}/dwl-install.sh

# install & apply the tokyonight GTK theme
if [ -d /root/theme-src ]; then
    echo "Installing GTK theme: ${THEME_NAME} ..."
    mkdir -p "/home/${USERNAME}/.local/share/themes"
    cp -r /root/theme-src "/home/${USERNAME}/.local/share/themes/${THEME_NAME}"
    chown -R ${USERNAME}:${USERNAME} "/home/${USERNAME}/.local/share/themes"
    rm -rf /root/theme-src

    # nwg-look has no config file of its own for gtk-theme/font/prefer-dark,
    # it reads and writes those straight to gsettings (dconf), so that's
    # what we set here. dbus-run-session gives dconf a session bus to talk
    # to since there's no session running yet inside the chroot.
    su - "${USERNAME}" -c "dbus-run-session -- bash -c '
        gsettings set org.gnome.desktop.interface gtk-theme \"${THEME_NAME}\" &&
        gsettings set org.gnome.desktop.interface color-scheme \"prefer-dark\" &&
        gsettings set org.gnome.desktop.interface font-name \"${THEME_FONT}\"
    '" || echo "WARNING: gsettings apply failed, set the theme manually in nwg-look later."

    # export to gtk-3.0/gtk-4.0 settings.ini too, for apps that don't read gsettings directly
    su - "${USERNAME}" -c "dbus-run-session -- nwg-look -x" \
        || echo "WARNING: nwg-look -x export failed, run it manually later."

    echo "GTK theme '${THEME_NAME}' applied (font: ${THEME_FONT}, prefer-dark: on)."
else
    echo "WARNING: /root/theme-src not staged, tokyonight theme was not installed."
fi

# nnn plugins (adds the preview-tui plugin used by NNN_PLUG above)
su - "${USERNAME}" -c "sh -c \"\$(curl -Ls https://raw.githubusercontent.com/jarun/nnn/master/plugins/getplugs)\"" \
    || echo "WARNING: nnn plugin install failed, run 'getplugs' manually later."

# ble.sh (bash equivalent of zsh-autosuggestions + fast-syntax-highlighting,
# loaded from ~/.bashrc); pre-install it here so first login doesn't have
# to build it on the spot
su - "${USERNAME}" -c 'src=$(mktemp -d) \
    && git clone --recursive --depth 1 https://github.com/akinomyoga/ble.sh.git "$src" \
    && make -C "$src" install PREFIX="$HOME/.local" \
    && rm -rf "$src"' \
    || echo "WARNING: ble.sh install failed, it will be retried automatically on first login."

# usbmount: auto-mount USB drives on plug-in (udev-triggered, no daemon/session needed)
if [ -f /etc/usbmount/usbmount.conf ]; then
    sed -i '/^FS_MOUNTOPTIONS=/d' /etc/usbmount/usbmount.conf
    echo 'FS_MOUNTOPTIONS="-fstype=vfat,gid=storage,dmask=0022,fmask=0133 -fstype=exfat,gid=storage,dmask=0022,fmask=0133 -fstype=ntfs,gid=storage,dmask=0022,fmask=0133"' \
        >> /etc/usbmount/usbmount.conf
else
    echo "WARNING: /etc/usbmount/usbmount.conf not found, usbmount may not be installed correctly."
fi

# restore normal (password-required) doas policy
cat > /etc/doas.conf <<'DOASCONF'
permit persist :wheel
DOASCONF
chmod 0400 /etc/doas.conf

# seatd for dwl
ln -sf /etc/runit/sv/seatd /etc/runit/runsvdir/default/ 2>/dev/null || true
usermod -aG seat "${USERNAME}"

if [ -d /sys/firmware/efi/efivars ]; then
    grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=Artix
else
    grub-install --target=i386-pc ${DISK}
fi
grub-mkconfig -o /boot/grub/grub.cfg
EOF

chmod +x /mnt/root/chroot-setup.sh
artix-chroot /mnt /root/chroot-setup.sh
rm /mnt/root/chroot-setup.sh

info "Installation complete!"
echo
echo "For Wi-Fi after reboot, use: iwctl"
echo
info "Unmounting and rebooting in 5 seconds ... (Ctrl+C to cancel)"
sleep 5
umount -R /mnt
reboot
