{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/asci.txt",
        "color": {
            "1": "#7aa2f7"
        },
        "height": 12,
        "padding": {
            "top": 2,
            "right": 5,
            "left": 3
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#bb9af7",
            "title": "#7aa2f7",
            "output": "#c0caf5"
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "key": "\u001b[38;2;187;154;247m┌────────────────────────────────────────────────────────────────┐\u001b[0m"
        },
        {
            "type": "custom",
            "key": "\u001b[38;2;187;154;247m│                                                                │\u001b[0m"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;187;154;247m│\u001b[0m  \u001b[38;2;122;162;247mOwner\u001b[0m        ",
            "text": "echo $USER | tr '[:lower:]' '[:upper:]'",
            "format": "\u001b[38;2;192;202;245m{>45}\u001b[0m  \u001b[38;2;187;154;247m│\u001b[0m"
        },
        {
            "type": "os",
            "key": "\u001b[38;2;187;154;247m│\u001b[0m  \u001b[38;2;122;162;247mOS\u001b[0m           ",
            "format": "\u001b[38;2;192;202;245m{pretty-name>45}\u001b[0m  \u001b[38;2;187;154;247m│\u001b[0m"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;187;154;247m│\u001b[0m  \u001b[38;2;122;162;247mKernel\u001b[0m       ",
            "text": "uname -r | cut -d '-' -f1",
            "format": "\u001b[38;2;192;202;245m{>45}\u001b[0m  \u001b[38;2;187;154;247m│\u001b[0m"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;187;154;247m│\u001b[0m  \u001b[38;2;122;162;247mUptime\u001b[0m       ",
            "text": "uptime -p | sed -E 's/up //; s/ days?/d/g; s/ hours?/h/g; s/ minutes?/m/g'",
            "format": "\u001b[38;2;192;202;245m{>45}\u001b[0m  \u001b[38;2;187;154;247m│\u001b[0m"
        },
        {
            "type": "shell",
            "key": "\u001b[38;2;187;154;247m│\u001b[0m  \u001b[38;2;122;162;247mShell\u001b[0m        ",
            "format": "\u001b[38;2;192;202;245m{pretty-name>45}\u001b[0m  \u001b[38;2;187;154;247m│\u001b[0m"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;187;154;247m│\u001b[0m  \u001b[38;2;122;162;247mWM\u001b[0m           ",
            "text": "echo $XDG_CURRENT_DESKTOP",
            "format": "\u001b[38;2;192;202;245m{>45}\u001b[0m  \u001b[38;2;187;154;247m│\u001b[0m"
        },
        {
            "key": "\u001b[38;2;187;154;247m│\u001b[0m  \u001b[38;2;122;162;247mOS Age\u001b[0m       ",
            "type": "disk",
            "folders": "/",
            "format": "\u001b[38;2;192;202;245m{days>40} days\u001b[0m  \u001b[38;2;187;154;247m│\u001b[0m"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;187;154;247m│\u001b[0m  \u001b[38;2;122;162;247mRam\u001b[0m          ",
            "text": "awk '/MemTotal/{g=$2/1024/1024; e=log(g)/log(2); c=(e==int(e))?e:int(e)+1; printf \"%d GB\", 2^c}' /proc/meminfo",
            "format": "\u001b[38;2;192;202;245m{>45}\u001b[0m  \u001b[38;2;187;154;247m│\u001b[0m"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;187;154;247m│\u001b[0m  \u001b[38;2;122;162;247mCPU\u001b[0m          ",
            "text": "lscpu | grep 'Model name' | awk -F: '{print $2}' | sed -E 's/^[[:space:]]+//; s/\\(R\\)//g; s/\\(TM\\)//g; s/ CPU//; s/@.*//' | xargs",
            "format": "\u001b[38;2;192;202;245m{>45}\u001b[0m  \u001b[38;2;187;154;247m│\u001b[0m"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;187;154;247m│\u001b[0m  \u001b[38;2;122;162;247miGPU\u001b[0m         ",
            "text": "lspci | grep -E 'VGA compatible controller|3D controller' | grep -viE 'nvidia' | grep -vE 'Radeon (RX|Pro|VII)' | head -n1 | sed -E 's/.*\\[([^]]+)\\].*/\\1/'",
            "format": "\u001b[38;2;192;202;245m{>45}\u001b[0m  \u001b[38;2;187;154;247m│\u001b[0m"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;187;154;247m│\u001b[0m  \u001b[38;2;122;162;247mdGPU\u001b[0m         ",
            "text": "lspci | grep -E 'VGA compatible controller|3D controller' | grep -iE 'nvidia|Radeon (RX|Pro|VII)' | head -n1 | sed -E 's/.*\\[([^]]+)\\].*/\\1/'",
            "format": "\u001b[38;2;192;202;245m{>45}\u001b[0m  \u001b[38;2;187;154;247m│\u001b[0m"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;187;154;247m│\u001b[0m  \u001b[38;2;122;162;247mDisk\u001b[0m         ",
            "text": "df -h --output=size,used,fstype / | awk 'NR==2 {gsub(/G/,\"\",$1); gsub(/G/,\"\",$2); print $2 \" / \" $1 \" GiB - \" $3}'",
            "format": "\u001b[38;2;192;202;245m{>45}\u001b[0m  \u001b[38;2;187;154;247m│\u001b[0m"
        },
        {
            "type": "packages",
            "key": "\u001b[38;2;187;154;247m│\u001b[0m  \u001b[38;2;122;162;247mPackages\u001b[0m     ",
            "format": "\u001b[38;2;192;202;245m{all>45}\u001b[0m  \u001b[38;2;187;154;247m│\u001b[0m"
        },
        {
            "type": "custom",
            "key": "\u001b[38;2;187;154;247m│                                                                │\u001b[0m"
        },
        {
            "type": "command",
            "key": " ",
            "shell": "/bin/bash",
            "text": "echo '\u001b[38;2;187;154;247m│\u001b[0m                 \u001b[38;2;122;162;247mWE ARE LIBRE ! ── 我々は自由だ！\u001b[0m               \u001b[38;2;187;154;247m│\u001b[0m'",
            "format": "{1}"
        },
        {
            "type": "custom",
            "key": "\u001b[38;2;187;154;247m└────────────────────────────────────────────────────────────────┘\u001b[0m"
        },
        "break"
    ]
}
